# ====================================================
# ICMR-STW AI Environment Configuration
# ====================================================

# Application Info
PROJECT_NAME="ICMR-Guided Clinical Workflow Intelligence System"
PROJECT_SHORT_NAME="ICMR-STW AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database settings (PostgreSQL supported; fallback to local SQLite for development)
# Example Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/icmr_stw_db
# Sync URL for Alembic / sync operations: postgresql://postgres:postgres@localhost:5432/icmr_stw_db
DATABASE_URL="sqlite:///./icmr_stw.db"

# Vector Database (ChromaDB)
CHROMA_USE_CLOUD=False
CHROMA_API_KEY=""
CHROMA_TENANT="default_tenant"
CHROMA_DATABASE="default_database"
CHROMA_PERSIST_DIRECTORY="./vector_db"
CHROMA_COLLECTION_NAME="icmr_stw_chunks"

# Embedding Model Configuration
# High quality clinical / general sentence transformer
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# LLM / SLM Provider Settings
# Supported providers: "mistral", "mock" (offline testing), "local" (Ollama / vLLM)
LLM_PROVIDER="mistral"

MISTRAL_API_KEY=""
MISTRAL_MODEL="ministral-8b-latest"

LOCAL_SLM_BASE_URL="http://localhost:11434/v1"
LOCAL_SLM_MODEL="qwen2.5:7b"

# RAG & Retrieval Parameters
RETRIEVAL_TOP_K=5
RETRIEVAL_RELEVANCE_THRESHOLD=0.45
ENABLE_HYBRID_RETRIEVAL=True
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# Safety & Grounding Controls
GROUNDING_STRICT_MODE=True
MAX_QUERY_LENGTH=500
MIN_EVIDENCE_TOKENS=30
REQUIRE_ICMR_CITATION=True
